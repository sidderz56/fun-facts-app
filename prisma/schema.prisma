// Fun Facts App — database schema
// Full v1.2 shape per spec sections 3.1 (Fact), 3.2 (Category), 3.3 (Session),
// 3.4 (ThisDayInHistory, Phase 3), 3.5 (FactRevision, Phase 4), 3.6/5.3
// (Report + abuse limiting, Phase 5), 5.8 (Event, Phase 7).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  draft
  pending_review
  verified
  rejected
  needs_reverification
}

enum ReverificationCadence {
  none
  quarterly
  semiannual
  annual
  biennial
  custom
}

enum FactLengthClass {
  short
  medium
  long
}

enum RetiredReason {
  became_false
  became_ambiguous
  report_upheld
  superseded
  other
}

enum RevisionChangeType {
  created
  text_edited
  status_changed
  retired
  restored
  reverified
  quality_rescored
  superseded
}

// spec 5.8's five tracked events. fact_viewed's four source values
// (tile/another/random/share_page) are also how "category taps per
// session" and "Another taps per session" are derived — neither needs its
// own event type, they're just fact_viewed filtered by source.
enum EventType {
  fact_viewed
  share_initiated
  report_submitted
  exhaustion_hit
  share_page_arrival
}

enum FactViewSource {
  tile
  another
  random
  share_page
}

enum ExhaustionScope {
  category
  all
}

model Category {
  id               String @id @default(uuid())
  name             String
  slug             String @unique
  iconAsset        String @map("icon_asset")
  targetProportion Float  @map("target_proportion")
  displayOrder     Int    @map("display_order")

  facts Fact[]

  @@map("categories")
}

model Fact {
  id         String   @id @default(uuid())
  text       String
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  // 1-2 of the 21 pattern IDs from the reference doc. Null in Phase 0 (spec 2.2).
  patternTags String[] @default([]) @map("pattern_tags")

  // array[{url, name, accessed_date, tier}], see spec 2.4. Empty in Phase 0.
  sources Json @default("[]")

  wordCount       Int?             @map("word_count")
  factLengthClass FactLengthClass? @map("fact_length_class")
  qualityScore    Int?             @map("quality_score")

  timeSensitive          Boolean                @default(false) @map("time_sensitive")
  reverificationCadence  ReverificationCadence?  @map("reverification_cadence")
  reverificationDueDate  DateTime?              @map("reverification_due_date") @db.Date

  // Phase 4: the verification workflow (spec 2.4) is now enforced at the
  // status transition (lib/verification.ts) — only `verified` and
  // `needs_reverification` facts are ever served (both are "publishable"
  // per spec 2.4 Phase 1 step 3). Defaults to `draft`, closing the Phase 0
  // shortcut that previously defaulted every fact straight to `verified`.
  verificationStatus VerificationStatus @default(draft) @map("verification_status")
  verificationNote   String?            @map("verification_note")

  dateAdded        DateTime  @default(now()) @map("date_added") @db.Date
  dateLastVerified DateTime? @map("date_last_verified") @db.Date

  shareSlug String @unique @map("share_slug")

  active        Boolean        @default(true)
  retiredReason RetiredReason? @map("retired_reason")

  supersededById String? @map("superseded_by")
  supersededBy   Fact?   @relation("FactSupersession", fields: [supersededById], references: [id])
  supersedes     Fact[]  @relation("FactSupersession")

  reportsSinceReview Int @default(0) @map("reports_since_review")

  revisions FactRevision[]
  reports   Report[]

  @@index([categoryId])
  @@map("facts")
}

// Append-only audit trail (spec 3.5) — nothing is ever updated in place or
// hard-deleted. Every Fact state change (creation, edits, status changes,
// retirement, etc.) writes a row here via lib/factMutations.ts.
model FactRevision {
  id     String @id @default(uuid())
  factId String @map("fact_id")
  // onDelete: Cascade exists only for scripts/seed-dev.ts's dev-only
  // wipe-and-recreate cycle — the app's own code paths (lib/factMutations.ts)
  // never delete a Fact at all, matching spec 3.5's "no fact is ever
  // hard-deleted" guarantee.
  fact Fact @relation(fields: [factId], references: [id], onDelete: Cascade)

  changedAt  DateTime           @default(now()) @map("changed_at")
  changeType RevisionChangeType @map("change_type")

  previousText   String? @map("previous_text")
  previousStatus String? @map("previous_status")
  newStatus      String? @map("new_status")

  // Free text; required on `retired` and `text_edited` (spec 3.5) — enforced
  // by lib/factMutations.ts, not the schema, since drafts writing a
  // `created` row have nothing to give a reason for.
  reason String?

  // "founder" or "system" (automated re-verification flag, auto-pull).
  actor String

  @@index([factId])
  @@map("fact_revisions")
}

model ThisDayInHistory {
  id String @id @default(uuid())

  // "MM-DD" — deliberately NOT unique (spec 3.4): multiple candidate facts
  // per date so the same user doesn't see the identical entry every year,
  // and a retired entry doesn't leave a hole in the calendar.
  monthDay String @map("month_day")

  text String

  // array[{url, name, accessed_date, tier}], same requirements as 2.4. Empty in Phase 3.
  sources Json @default("[]")

  wordCount Int? @map("word_count")

  shareSlug String @unique @map("share_slug")

  // Phase 4: same treatment as Fact.verificationStatus — defaults to
  // `draft`, gated by the same lib/verification.ts checks (spec 3.4:
  // sources and word_count follow "the same requirements as 2.4" / "2.9").
  verificationStatus VerificationStatus @default(draft) @map("verification_status")

  qualityScore Int? @map("quality_score")

  // Drives year-over-year rotation (spec 3.4): among active+verified
  // entries for today's month_day, the oldest date_last_shown (nulls
  // first) is served, tie-broken by highest quality_score.
  dateLastShown DateTime? @map("date_last_shown") @db.Date

  active Boolean @default(true)

  @@index([monthDay])
  @@map("this_day_in_history")
}

model Session {
  anonId String @id @default(uuid()) @map("anon_id")

  // Server-side only (spec 3.3) — never stored in the cookie.
  seenFactIds String[] @default([]) @map("seen_fact_ids")

  lastHistoryFactShownDate DateTime? @map("last_history_fact_shown_date") @db.Date

  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  reports Report[]
  events  Event[]

  @@map("sessions")
}

// spec 5.8: "an event table and a handful of queries, not an analytics
// platform." Deliberately flat (a handful of nullable columns) rather than
// a JSON payload — every field here is something a query in
// lib/analyticsQueries.ts actually filters or groups on, and a flat schema
// keeps those queries plain SQL instead of JSON-path expressions.
//
// categorySlug is "" for This Day In History entries (matching the
// existing HISTORY_CATEGORY.slug convention in app/fact/[slug]/page.tsx)
// rather than null, so category-grouped queries don't need a null-handling
// branch. shareSlug is stored instead of a Fact/ThisDayInHistory FK because
// those are two different tables sharing one share_slug URL space (spec
// 3.4) — a single string column reads across both without a variant FK.
model Event {
  id     String @id @default(uuid())
  anonId String @map("anon_id")
  session Session @relation(fields: [anonId], references: [anonId])

  type EventType

  // fact_viewed, share_initiated, report_submitted: which fact/history
  // entry and category. null for exhaustion_hit (no single fact involved).
  shareSlug    String? @map("share_slug")
  categorySlug String? @map("category_slug")

  // fact_viewed only.
  source FactViewSource?

  // exhaustion_hit only.
  exhaustionScope ExhaustionScope? @map("exhaustion_scope")

  createdAt DateTime @default(now()) @map("created_at")

  // (anonId, createdAt) covers per-user-per-day queries (north star,
  // session duration, retention); (type, createdAt) covers the
  // content/acquisition aggregates that scan one event type across all users.
  @@index([anonId, createdAt])
  @@index([type, createdAt])
  @@index([categorySlug, type])
  @@map("events")
}

// Individual report rows, not just a counter — this is what makes dedup
// possible (spec 3.6). One open report per (fact, anon_id): enforced here at
// the application level (lib/reporting.ts checks before insert) AND at the
// database level by a partial unique index added by hand in this model's
// migration — Prisma's schema DSL has no `WHERE` clause for `@@unique`, so
// `CREATE UNIQUE INDEX ... WHERE resolved_at IS NULL` was appended directly
// to migrations/*_add_reports_and_config/migration.sql after generation.
model Report {
  id     String @id @default(uuid())
  factId String @map("fact_id")
  fact   Fact   @relation(fields: [factId], references: [id])
  anonId String @map("anon_id")
  session Session @relation(fields: [anonId], references: [anonId])

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([factId])
  @@index([anonId, createdAt])
  @@map("reports")
}

// Transient store for the per-IP rate limit (spec 5.2, 5.3): IPs are used
// only to blunt cookie-clearing abuse and must never land on the `reports`
// row itself, so they live here instead, hashed, and pruned back to the
// rolling 1-hour window on every write (lib/reporting.ts) rather than
// retained indefinitely.
model ReportRateLimitEvent {
  id        String   @id @default(uuid())
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipHash, createdAt])
  @@map("report_rate_limit_events")
}

// Generic key/value application config (spec 5.3: "the threshold lives in
// application config, not in code, and is editable without a deploy").
// Only `auto_pull_threshold` exists today; any future tunable value not
// worth a code change goes here rather than growing a new single-purpose
// table each time.
model AppConfig {
  key   String @id
  value String

  @@map("app_config")
}
