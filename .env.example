# Postgres connection string. In dev, get this from your Neon project dashboard
# (Connection Details -> the "pooled connection" string). Copy this file to
# .env and fill in the real value there — .env is gitignored, .env.example is not.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin dashboard auth (spec 5.7) — Auth.js + GitHub OAuth, single founder
# account. Generate AUTH_SECRET with: npx auth secret (or `openssl rand -base64 33`).
AUTH_SECRET="generate-with-npx-auth-secret"
# From your GitHub OAuth App (github.com/settings/developers -> New OAuth App).
# Authorization callback URL must be exactly: <your-site-url>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Your GitHub username — the ONLY login that will ever be granted a dashboard session.
ADMIN_GITHUB_LOGIN=""

# Bearer token for the internal content-drafting endpoints
# (app/api/internal/draft-fact, app/api/internal/existing-facts), used by
# the scheduled daily drafting routine — NOT your database credentials, so
# it can be set in a cloud environment's plaintext env var box without the
# risk that implies for a real DB connection string. Generate with:
# openssl rand -hex 32
INTERNAL_DRAFT_API_KEY=""
